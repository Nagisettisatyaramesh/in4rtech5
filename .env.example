PORT=5000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret
# PostgreSQL. Tables are created and updated automatically on first use (backend/db/migrations).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=in4rtech_app_db
DB_USER=in4rtech_app
DB_PASSWORD=change-me
# disable | prefer | require | verify-full (prefer connects without TLS)
DB_SSLMODE=prefer
# Optional SSH tunnel: connect to SSH_HOST, then to DB_REMOTE_HOST:DB_REMOTE_PORT from that server.
DB_REMOTE_HOST=127.0.0.1
DB_REMOTE_PORT=5432
SSH_ENABLED=false
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
# Email each new enquiry via Gmail SMTP: EMAIL_USER is the Gmail address (also copied on each email), EMAIL_PASS a Google app password.
EMAIL_USER=
EMAIL_PASS=
CONTACT_TO=ramesh.nagisetti@vitalitysoft.com
