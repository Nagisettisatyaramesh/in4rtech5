PORT=5000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret
# Supabase project URL and service-role (secret) key. Server only; never put the key in frontend files.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
# Email each new enquiry via Gmail SMTP: EMAIL_USER is the Gmail address (also copied on each email), EMAIL_PASS a Google app password.
EMAIL_USER=
EMAIL_PASS=
CONTACT_TO=ramesh.nagisetti@vitalitysoft.com
