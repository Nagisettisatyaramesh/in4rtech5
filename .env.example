PORT=5000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret
# Supabase project URL and service-role (secret) key. Server only; never put the key in frontend files.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
# Email each new enquiry via Resend (https://resend.com). CONTACT_FROM must use a domain verified in Resend.
RESEND_API_KEY=
CONTACT_TO=rajneesh@in4rtech.com
CONTACT_FROM=In4rtech Website <website@in4rtech.com>
